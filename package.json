{
  "name": "javiserver",
  "private": true,
  "version": "2.2.7",
  "description": "Gestor SSH Multi-servidor para explorar archivos y logs de servidores",
  "author": "jasegura",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "build:mcp-bridge": "node scripts/build-mcp-bridge.mjs --sea",
    "build:mcp-bridge:bundle": "node scripts/build-mcp-bridge.mjs",
    "build": "npm run build:web && npm run build:mcp-bridge && electron-builder --publish never",
    "release": "npm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "tsx --test tests/**/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "cpu-features": "file:vendor/cpu-features",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ssh2": "1.17.0",
    "xterm": "5.3.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/ssh2": "1.15.5",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.5.0",
    "electron": "40.10.3",
    "electron-builder": "26.15.3",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.26",
    "postcss": "8.5.15",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vite-plugin-electron": "1.0.4",
    "vite-plugin-electron-renderer": "1.0.0"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.javiervaldez.javiserver",
    "productName": "JaviServer",
    "asar": true,
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://storage.googleapis.com/artictools-releases/javiserver/releases"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-Mac-${version}-Installer.${ext}",
      "extraResources": [
        {
          "from": "dist-mcp-bridge/bridge.cjs",
          "to": "bridge/bridge.cjs"
        },
        {
          "from": "dist-mcp-bridge/javiserver-mcp-bridge",
          "to": "bridge/javiserver-mcp-bridge"
        }
      ]
    },
    "dmg": {
      "window": {
        "width": 640,
        "height": 420
      },
      "contents": [
        {
          "x": 160,
          "y": 170
        },
        {
          "x": 460,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 310,
          "y": 320,
          "type": "file",
          "path": "build/INSTALL-MAC.txt",
          "name": "Instrucciones.txt"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
      "extraFiles": [
        {
          "from": "dist-mcp-bridge/JaviServerMcp.exe",
          "to": "JaviServerMcp.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
